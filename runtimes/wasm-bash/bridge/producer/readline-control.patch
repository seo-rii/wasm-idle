+/* Share bind -x's parser and editing-buffer preservation with the opt-in
+   idle callback. POLL never clears or redraws an unchanged editing line. */
+static int
+bash_execute_readline_command (char *cmd, int poll)
+{
+  register int i, r;
+  intmax_t mi;
+  sh_parser_state_t ps;
+  char *value, *ce, *prompt;
+  SHELL_VAR *v;
+  char ibuf[INT_STRLEN_BOUND(int) + 1];
+
+  ce = poll ? 0 : rl_get_termcap ("ce");
   if (ce)	/* clear current line */
     {
       rl_clear_visible_line ();
       fflush (rl_outstream);
     }
-  else
+  else if (poll == 0)
     rl_crlf ();	/* move to a new line */
 
   v = bind_variable ("READLINE_LINE", rl_line_buffer, 0);
@@ -4471,9 +4490,19 @@

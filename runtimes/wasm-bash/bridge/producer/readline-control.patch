+/* Called by Readline only when its real input queue has no character ready.
+   Foreground commands, `read -e`, heredocs and continuation prompts do not
+   constitute a host-control boundary. No bytes are injected into stdin. */
+static int
+wasm_idle_readline_poll (void)
+{
+  static int active = 0;
+  SHELL_VAR *function;
+  char *lastarg;
+  int lastsignal;
+
+  if (active || executing || interactive_shell == 0 ||
+      get_current_prompt_level () != 1 || rl_done ||
+      RL_ISSTATE (RL_STATE_READCMD) == 0 ||
+      RL_ISSTATE (RL_STATE_METANEXT | RL_STATE_DISPATCHING | RL_STATE_MOREINPUT |
+                  RL_STATE_ISEARCH | RL_STATE_NSEARCH | RL_STATE_SEARCH |
+                  RL_STATE_NUMERICARG | RL_STATE_MACROINPUT | RL_STATE_MACRODEF |
+                  RL_STATE_COMPLETING | RL_STATE_SIGHANDLER | RL_STATE_UNDOING |
+                  RL_STATE_INPUTPENDING | RL_STATE_VIMOTION | RL_STATE_MULTIKEY |
+                  RL_STATE_CHARSEARCH | RL_STATE_REDISPLAYING | RL_STATE_DONE))
+    return 0;
+
+  function = find_function ("__wasm_idle_poll");
+  if (function == 0 || readonly_p (function) == 0)
+    return 0;
+
+  active = 1;
+  lastsignal = last_command_exit_signal;
+  lastarg = get_string_value ("_");
+  if (lastarg)
+    lastarg = savestring (lastarg);
+  bash_execute_readline_command ("__wasm_idle_poll", 1);
+  last_command_exit_signal = lastsignal;
+  bind_variable ("_", lastarg, 0);
+  FREE (lastarg);
+  active = 0;
   return 0;
 }
 

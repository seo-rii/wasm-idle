+#[cfg(test)]
+mod container_filesystem_error_tests {
+    use super::*;
+
+    #[test]
+    fn exact_filesystem_errors_survive_async_io() {
+        for error in [FsError::StorageFull, FsError::InvalidFd, FsError::BaseNotDirectory,
+            FsError::DirectoryNotEmpty, FsError::WouldBlock, FsError::Unsupported] {
+            let io: io::Error = error.into();
+            assert_eq!(io.get_ref().unwrap().downcast_ref::<FsError>(), Some(&error));
+            assert_eq!(FsError::from(io), error);
+        }
+    }
+
+    #[test]
+    fn ordinary_io_errors_keep_their_existing_mapping() {
+        assert_eq!(FsError::from(io::Error::from(io::ErrorKind::Other)), FsError::IOError);
+        assert_eq!(FsError::from(io::Error::from(io::ErrorKind::WouldBlock)), FsError::WouldBlock);
+    }
+}

+    /// Check a cached child of a live mount against the backing filesystem and
+    /// refresh its stat. Returns false when the cached entry must be discarded.
+    fn revalidate_live_entry(&self, entry: &InodeGuard, path: &Path) -> Result<bool, Errno> {
+        let metadata = match self.root_fs.symlink_metadata(path) {
+            Ok(metadata) => metadata,
+            Err(FsError::EntryNotFound) | Err(FsError::BaseNotDirectory) => return Ok(false),
+            Err(_) => return Err(Errno::Io),
+        };
+        let file_type = metadata.file_type();
+        let (matches, is_file) = match entry.read().deref() {
+            Kind::Dir { .. } => (file_type.is_dir(), false),
+            Kind::File { fd: None, .. } => (file_type.is_file(), true),
+            _ => (true, false),
+        };
+        if matches {
+            let mut stat = entry.stat.write().unwrap();
+            if is_file {
+                stat.st_size = metadata.len();
+            }
+            stat.st_mtim = metadata.modified();
+            stat.st_atim = metadata.accessed();
+            stat.st_ctim = metadata.created();
+        }
+        Ok(matches)
+    }

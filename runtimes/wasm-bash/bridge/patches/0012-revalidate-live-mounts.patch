+
+/// Mount prefixes whose backing filesystem other processes change concurrently.
+/// Cached inodes below them are revalidated on every lookup.
+static LIVE_MOUNTS: std::sync::RwLock<Vec<std::path::PathBuf>> = std::sync::RwLock::new(Vec::new());
+
+/// Register a live mount prefix. Revalidating a mount that is not live costs
+/// extra metadata calls but never changes results.
+pub fn register_live_mount(path: impl AsRef<std::path::Path>) {
+    let path = path.as_ref().to_path_buf();
+    if let Ok(mut mounts) = LIVE_MOUNTS.write() {
+        if !mounts.contains(&path) {
+            mounts.push(path);
+        }
+    }
+}
+
+pub(crate) fn is_live_path(path: &std::path::Path) -> bool {
+    LIVE_MOUNTS
+        .read()
+        .map(|mounts| mounts.iter().any(|mount| path.starts_with(mount)))
+        .unwrap_or(false)
+}

+    /// Return one host-command descriptor result to the scheduler thread.
+    pub(crate) fn host_command_reply(
+        &self,
+        reply: crate::host_command::HostCommandReply,
+    ) -> Result<(), anyhow::Error> {
+        self.scheduler
+            .send(SchedulerMessage::HostCommandReply(Box::new(reply)))
+    }
+
     pub fn close(&self) {
         self.scheduler.close();
     }

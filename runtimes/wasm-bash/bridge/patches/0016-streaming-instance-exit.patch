+    /// Wait only for the process exit status, without closing stdin or reading
+    /// stdout/stderr. Like `wait`, this consumes the Instance. Retain its stream
+    /// properties first; the caller owns EOF, draining and stream cleanup.
+    /// Cancellation and the Worker group's lifetime remain owner responsibilities.
+    #[wasm_bindgen(js_name = "waitForExit")]
+    pub async fn js_wait_for_exit(self) -> Result<JsExitStatus, Error> {
+        let ExitCondition(code) = self.exit.await.map_err(Error::from)?;
+        let status = js_sys::Object::new();
+        js_sys::Reflect::set(&status, &JsValue::from_str("code"), &JsValue::from(code))
+            .map_err(Error::js)?;
+        js_sys::Reflect::set(&status, &JsValue::from_str("ok"), &JsValue::from(code == 0))
+            .map_err(Error::js)?;
+        Ok(js_sys::Object::freeze(&status).unchecked_into())
+    }
 }
 

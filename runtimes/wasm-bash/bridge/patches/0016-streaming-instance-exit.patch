+    #[wasm_bindgen_test]
+    async fn exit_only_preserves_unlocked_streams_without_waiting_for_output_eof() {
+        for code in [0, 23, 126, 255] {
+            let (mut guest_stdin, stdin) = crate::streams::input_pipe();
+            let (mut guest_stdout, stdout) = crate::streams::output_pipe();
+            let (mut guest_stderr, stderr) = crate::streams::output_pipe();
+            let (sender, exit) = oneshot::channel();
+            let instance = Instance {
+                stdin: Some(stdin.clone()),
+                stdout: stdout.clone(),
+                stderr: stderr.clone(),
+                exit,
+            };
+            let bytes = [0, 255, 226, 130, 172];
+            guest_stdout.write_all(&bytes).await.unwrap();
+            guest_stderr.write_all(&bytes).await.unwrap();
+            // Neither output is closed and no caller has locked stdin. Legacy
+            // wait() would close input and wait for the output EOFs here.
+            sender.send(ExitCondition::Exited(code)).unwrap();
+            let status: JsValue = instance.js_wait_for_exit().await.unwrap().into();
+            assert_eq!(
+                js_sys::Reflect::get(&status, &"code".into())
+                    .unwrap()
+                    .as_f64(),
+                Some(code as f64)
+            );
+            assert_eq!(
+                js_sys::Reflect::get(&status, &"ok".into())
+                    .unwrap()
+                    .as_bool(),
+                Some(code == 0)
+            );
+            assert!(js_sys::Reflect::get(&status, &"stdoutBytes".into())
+                .unwrap()
+                .is_undefined());
+            assert!(!stdin.locked());
+            assert!(!stdout.locked());
+            assert!(!stderr.locked());
+
+            // Exit observation did not close input or consume buffered output.
+            let writer = web_sys::WritableStreamDefaultWriter::new(&stdin).unwrap();
+            let chunk = Uint8Array::from(bytes.as_slice());
+            wasm_bindgen_futures::JsFuture::from(writer.write_with_chunk(&chunk))
+                .await
+                .unwrap();
+            let mut input = [0u8; 5];
+            guest_stdin.read_exact(&mut input).await.unwrap();
+            assert_eq!(input, bytes);
+            wasm_bindgen_futures::JsFuture::from(writer.close())
+                .await
+                .unwrap();
+            writer.release_lock();
+            for stream in [&stdout, &stderr] {
+                let reader = web_sys::ReadableStreamDefaultReader::new(stream).unwrap();
+                let result = wasm_bindgen_futures::JsFuture::from(reader.read())
+                    .await
+                    .unwrap();
+                let value = js_sys::Reflect::get(&result, &"value".into()).unwrap();
+                assert_eq!(Uint8Array::new(&value).to_vec(), bytes);
+                reader.release_lock();
+            }
+            guest_stdout.close();
+            guest_stderr.close();
+        }
+    }

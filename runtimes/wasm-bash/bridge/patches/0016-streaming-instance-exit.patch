+    #[wasm_bindgen_test]
+    async fn exit_only_accepts_caller_owned_readers_and_reports_a_lost_exit_channel() {
+        let (mut guest_stdin, stdin) = crate::streams::input_pipe();
+        let (mut guest_stdout, stdout) = crate::streams::output_pipe();
+        let (mut guest_stderr, stderr) = crate::streams::output_pipe();
+        let reader = web_sys::ReadableStreamDefaultReader::new(&stdout).unwrap();
+        let error_reader = web_sys::ReadableStreamDefaultReader::new(&stderr).unwrap();
+        let writer = web_sys::WritableStreamDefaultWriter::new(&stdin).unwrap();
+        let (sender, exit) = oneshot::channel();
+        let instance = Instance {
+            stdin: Some(stdin),
+            stdout,
+            stderr,
+            exit,
+        };
+        sender.send(ExitCondition(37)).unwrap();
+        let status: JsValue = instance.js_wait_for_exit().await.unwrap().into();
+        assert_eq!(
+            js_sys::Reflect::get(&status, &"code".into())
+                .unwrap()
+                .as_f64(),
+            Some(37.0)
+        );
+        writer.release_lock();
+        reader.release_lock();
+        error_reader.release_lock();
+        guest_stdin.close();
+        guest_stdout.close();
+        guest_stderr.close();
+
+        let (mut guest_stdout, stdout) = crate::streams::output_pipe();
+        let (mut guest_stderr, stderr) = crate::streams::output_pipe();
+        let (sender, exit) = oneshot::channel();
+        let instance = Instance {
+            stdin: None,
+            stdout,
+            stderr,
+            exit,
+        };
+        drop(sender);
+        assert!(instance.js_wait_for_exit().await.is_err());
+        guest_stdout.close();
+        guest_stderr.close();
+    }

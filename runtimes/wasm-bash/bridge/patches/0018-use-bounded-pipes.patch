+/// Preserve partial writes while awaiting capacity in a native bounded pipe.
+async fn write_pipe_data<M: MemorySize>(
+    endpoint: &mut (impl virtual_fs::AsyncWrite + Unpin),
+    data: &FdWriteSource<'_, M>,
+    memory: &wasmer::MemoryView<'_>,
+) -> Result<usize, Errno> {
+    use virtual_fs::AsyncWriteExt;
+    let pipe_error = |error: std::io::Error| match error.kind() {
+        std::io::ErrorKind::BrokenPipe => Errno::Pipe,
+        _ => map_io_err(error),
+    };
+    match data {
+        FdWriteSource::Iovs { iovs, iovs_len } => {
+            let array = iovs.slice(memory, *iovs_len).map_err(mem_error_to_wasi)?;
+            let array = array.access().map_err(mem_error_to_wasi)?;
+            let mut written = 0;
+            for iov in array.iter() {
+                let bytes = WasmPtr::<u8, M>::new(iov.buf)
+                    .slice(memory, iov.buf_len).map_err(mem_error_to_wasi)?;
+                let bytes = bytes.access().map_err(mem_error_to_wasi)?;
+                let count = match endpoint.write(bytes.as_ref()).await {
+                    Ok(count) => count,
+                    Err(_) if written > 0 => break,
+                    Err(error) => return Err(pipe_error(error)),
+                };
+                written += count;
+                // Returning after one nonempty iovec prevents a NONBLOCK
+                // timeout after earlier iovecs have already changed the pipe.
+                if written > 0 { break; }
+            }
+            Ok(written)
+        }
+        FdWriteSource::Buffer(bytes) => {
+            endpoint.write(bytes).await.map_err(pipe_error)
+        }
+    }
+}

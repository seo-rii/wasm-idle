 pub fn map_io_err(err: std::io::Error) -> Errno {
+    // Host filesystem operations use std::io for async traits, but Other alone
+    // cannot distinguish a full workspace from an actual I/O failure.
+    if let Some(error) = err.get_ref().and_then(|error| error.downcast_ref::<virtual_fs::FsError>()) {
+        return crate::fs::fs_error_into_wasi_err(*error);
+    }
     From::<std::io::Error>::from(err)
 }
 

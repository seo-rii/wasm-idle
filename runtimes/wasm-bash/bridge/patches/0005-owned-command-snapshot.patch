+//! Owned metadata for a prepared host-command invocation. This is not an fd or FS capability.
+
+/// Immutable owned values copied from a prepared child [`crate::WasiEnv`].
+///
+/// No guest-memory views, state locks, filesystem handles or descriptor endpoints
+/// are retained. The cwd names the child's existing WASIX directory; it does not
+/// grant access to a container workspace or describe a live filesystem binding.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct HostCommandSnapshot {
+    argv: Vec<String>,
+    environment: Vec<Vec<u8>>,
+    cwd: String,
+}
+
+impl HostCommandSnapshot {
+    pub(super) fn new(argv: Vec<String>, environment: Vec<Vec<u8>>, cwd: String) -> Self {
+        Self {
+            argv,
+            environment,
+            cwd,
+        }
+    }
+
+    /// Original prepared argv, including argv0, empty strings and embedded LF/CR.
+    pub fn argv(&self) -> &[String] {
+        &self.argv
+    }
+
+    /// Original prepared name=value entries, without lossy UTF-8 conversion.
+    /// These are metadata bytes, not host environment variables.
+    pub fn environment(&self) -> &[Vec<u8>] {
+        &self.environment
+    }
+
+    /// The cwd read through the child's WASIX filesystem directory lookup.
+    /// This is independent of any PWD environment string.
+    pub fn cwd(&self) -> &str {
+        &self.cwd
+    }
+}

{
	"name": "wasm-dotnet",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Browser-loadable .NET C#, F#, and VB.NET runtime contract for wasm-idle",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"default": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node scripts/clean-module-output.mjs && tsc -p tsconfig.build.json",
		"build:runtime": "node scripts/build-runtime.mjs",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	}
}

 #include "libbb.h"
 #include "bb_archive.h"
+
+#if defined(BB_WASI_B1)
+struct wasi_archive_directory_time {
+	struct wasi_archive_directory_time *next;
+	char *name;
+	time_t mtime;
+};
+
+void FAST_FUNC wasi_archive_restore_directory_times(archive_handle_t *archive_handle)
+{
+	struct wasi_archive_directory_time *entry = archive_handle->wasi_directory_times;
+	struct wasi_archive_directory_time *pending = NULL;
+
+	archive_handle->wasi_directory_times = NULL;
+	/* Restore in header order: duplicate (including ./ aliases) uses the last value.
+	 * This remains linear in archive headers, with no quadratic pathname scans. */
+	while (entry) {
+		struct wasi_archive_directory_time *next = entry->next;
+		entry->next = pending;
+		pending = entry;
+		entry = next;
+	}
+	while (pending) {
+		struct wasi_archive_directory_time *next = pending->next;
+		struct stat st;
+		struct timeval times[2];
+
+		wasi_archive_check_path(pending->name);
+		if (lstat(pending->name, &st) != 0)
+			bb_perror_msg_and_die("can't stat directory %s", pending->name);
+		if (!S_ISDIR(st.st_mode))
+			bb_error_msg_and_die("%s is no longer a directory", pending->name);
+		times[0].tv_sec = times[1].tv_sec = pending->mtime;
+		times[0].tv_usec = times[1].tv_usec = 0;
+		if (utimes(pending->name, times) != 0)
+			bb_perror_msg_and_die("cannot restore timestamp for %s", pending->name);
+		free(pending->name);
+		free(pending);
+		pending = next;
+	}
+}
+#endif
 

--- a/include/libbb.h
+++ b/include/libbb.h
@@ -73,6 +73,66 @@
 #endif
 #include <time.h>
 #include <sys/param.h>
+
+#if defined(BB_WASI_METADATA)
+#include <wasi/libc-find-relpath.h>
+__attribute__((import_module("wasm_idle_fs_v1"), import_name("path_mode")))
+extern int bb_wasi_path_mode(int, const char *, unsigned, unsigned);
+__attribute__((import_module("wasm_idle_fs_v1"), import_name("fd_mode")))
+extern int bb_wasi_fd_mode(int);
+
+/* Enrich real libc stat results with stored virtual permissions. libc resolves
+ * cwd/preopens itself; no environment-based path or permission emulation. */
+static inline int bb_wasi_enrich_path(const char *path, struct stat *info, unsigned follow)
+{
+	char storage[4096];
+	char *relative = storage;
+	const char *prefix;
+	int fd = __wasilibc_find_relpath(path, &prefix, &relative, sizeof(storage));
+	int mode;
+	if (fd < 0)
+		return -1;
+	mode = bb_wasi_path_mode(fd, relative, strlen(relative), follow);
+	if (mode < 0) {
+		errno = -mode;
+		return -1;
+	}
+	info->st_mode = (info->st_mode & S_IFMT) | (mode & 0777);
+	return 0;
+}
+static inline int bb_wasi_stat(const char *path, struct stat *info)
+{
+	if (stat(path, info))
+		return -1;
+	return bb_wasi_enrich_path(path, info, 1);
+}
+static inline int bb_wasi_lstat(const char *path, struct stat *info)
+{
+	if (lstat(path, info))
+		return -1;
+	return bb_wasi_enrich_path(path, info, 0);
+}
+static inline int bb_wasi_fstat(int fd, struct stat *info)
+{
+	int mode;
+	if (fstat(fd, info))
+		return -1;
+	mode = bb_wasi_fd_mode(fd);
+	/* Standard byte streams have no VFS inode. Reopened low descriptors still
+	 * receive their real stored mode whenever the import succeeds. */
+	if (mode == -EBADF && fd >= 0 && fd <= 2)
+		return 0;
+	if (mode < 0) {
+		errno = -mode;
+		return -1;
+	}
+	info->st_mode = (info->st_mode & S_IFMT) | (mode & 0777);
+	return 0;
+}
+#define stat(path, info) bb_wasi_stat(path, info)
+#define lstat(path, info) bb_wasi_lstat(path, info)
+#define fstat(fd, info) bb_wasi_fstat(fd, info)
+#endif
 #if !defined(BB_WASI_B0)
 #include <pwd.h>
 #endif

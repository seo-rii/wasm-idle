# Overlay onto allnoconfig, then resolve with oldconfig against BusyBox 1.37.0.
# Cumulative staged applet profile, with explicit WASI limitations.
CONFIG_BUSYBOX=y
CONFIG_CAT=y
CONFIG_PRINTF=y
CONFIG_ECHO=y
CONFIG_PWD=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
# CONFIG_FEATURE_SUID is not set
# CONFIG_FEATURE_SUID_CONFIG is not set
# CONFIG_FEATURE_INSTALLER is not set
# CONFIG_FEATURE_SH_STANDALONE is not set
# CONFIG_FEATURE_PREFER_APPLETS is not set
# CONFIG_STATIC is not set
# CONFIG_PIE is not set
CONFIG_LFS=y
CONFIG_FEATURE_COPYBUF_KB=4
# CONFIG_NOMMU is not set
CONFIG_SH_IS_NONE=y
# CONFIG_SH_IS_ASH is not set
# CONFIG_SH_IS_HUSH is not set
CONFIG_BASH_IS_NONE=y
# CONFIG_BASH_IS_ASH is not set
# CONFIG_BASH_IS_HUSH is not set
CONFIG_GREP=y
CONFIG_MKDIR=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
# CONFIG_FEATURE_PRESERVE_HARDLINKS is not set
# CONFIG_FEATURE_CP_LONG_OPTIONS is not set
# CONFIG_FEATURE_CP_REFLINK is not set
# CONFIG_SELINUX is not set

# B2: noninteractive directory, path and text utilities.
CONFIG_LS=y
CONFIG_RMDIR=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_TEE=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_FEATURE_READLINK_FOLLOW=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_SORT_BIG=y
# CONFIG_FEATURE_LS_COLOR is not set
# CONFIG_FEATURE_LS_COLOR_IS_DEFAULT is not set
# CONFIG_FEATURE_LS_USERNAME is not set
# CONFIG_FEATURE_LS_TIMESTAMPS is not set
# CONFIG_FEATURE_LS_RECURSIVE is not set
# CONFIG_FEATURE_LS_WIDTH is not set
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_UNICODE_SUPPORT=y
# CONFIG_UNICODE_USING_LOCALE is not set
CONFIG_LAST_SUPPORTED_WCHAR=0
CONFIG_UNICODE_WIDE_WCHARS=y
CONFIG_UNICODE_COMBINING_WCHARS=y

# Stage 2: actual upstream applets; no process-spawning find actions.
CONFIG_SED=y
CONFIG_FIND=y
CONFIG_FEATURE_FIND_PRINT0=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_MAXDEPTH=y
CONFIG_FEATURE_FIND_NOT=y
CONFIG_FEATURE_FIND_DEPTH=y
CONFIG_FEATURE_FIND_PAREN=y
CONFIG_FEATURE_FIND_SIZE=y
CONFIG_FEATURE_FIND_PRUNE=y
CONFIG_FEATURE_FIND_QUIT=y
CONFIG_FEATURE_FIND_EMPTY=y
CONFIG_FEATURE_FIND_PATH=y
CONFIG_FEATURE_FIND_REGEX=y
# CONFIG_FEATURE_FIND_EXEC is not set
# CONFIG_FEATURE_FIND_EXEC_PLUS is not set
# CONFIG_FEATURE_FIND_EXEC_OK is not set
# CONFIG_FEATURE_FIND_DELETE is not set
CONFIG_DIFF=y
CONFIG_FEATURE_DIFF_DIR=y
CONFIG_CMP=y
CONFIG_LN=y
CONFIG_SHA256SUM=y
CONFIG_FEATURE_MD5_SHA1_SUM_CHECK=y
CONFIG_BASE64=y
CONFIG_OD=y
CONFIG_HEXDUMP=y
CONFIG_FEATURE_OD_LARGE=y

# Stage 3: explicit virtual metadata, independent access/modification times.
CONFIG_TOUCH=y
CONFIG_FEATURE_TOUCH_SUSV3=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
# CONFIG_FEATURE_STAT_FILESYSTEM is not set
CONFIG_FEATURE_LS_TIMESTAMPS=y
# CONFIG_FEATURE_LS_USERNAME is not set
# CONFIG_FEATURE_LS_WIDTH is not set
# CONFIG_FEATURE_LS_COLOR is not set

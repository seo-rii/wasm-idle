    "bufferBytes": 4096,
    "failureExitCode": 125,
    "action": "validate result then call actual libc chdir before upstream main"
  },
  "limitations": [
    "Host owns creation modes; mkdir -m is rejected",
    "cp regular files and symlinks only; -p/-a/-r/-R/-l/-s are rejected before destination mutation",
    "mv uses same-mount rename only; cross-mount fallback is rejected without copy or unlink",
    "No ownership, timestamps, permission mutation, hardlink preservation or device/FIFO/socket copying",
    "grep -a/-I and NUL text input are rejected; no GNU regex extensions are emulated",
    "Noninteractive applets; tail -f/-F and tee -i are explicitly rejected",
    "ls -l/-n/-s await the virtual metadata profile; no terminal width or automatic color"
  ],

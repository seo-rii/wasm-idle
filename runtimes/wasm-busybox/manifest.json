    "signature": "(ptr:i32, capacity:i32)->i32",
    "result": "UTF-8 cwd and NUL byte count; -1 for insufficient capacity or invalid memory range",
    "constructorPriority": 101,
    "bufferBytes": 4096,
    "failureExitCode": 125,
    "action": "validate result then call actual libc chdir before upstream main"
  },
  "limitations": [
    "Host owns creation modes; mkdir -m is rejected",
    "cp recursive directory/regular/symlink content uses host creation modes; -p/-a/-l/-s are rejected before destination mutation",
    "mv uses same-mount rename only; cross-mount fallback is rejected without copy or unlink",
    "grep -a/-I and NUL text input are rejected; no GNU regex extensions are emulated",
    "Noninteractive applets; tail -f/-F and tee -i are explicitly rejected",
    "sed -i and find -exec/-ok/-delete are unsupported; ln requires symbolic -s mode",
    "No ownership or permission mutation, hardlink preservation or device/FIFO/socket copying",
    "touch and stat require the workspace Container virtual-metadata-v1 host; timestamps use integer milliseconds with noatime reads",
    "Numeric uid/gid 0 and nlink 1 describe the virtual filesystem; account names, allocated blocks and physical-device fields report UNKNOWN",
    "ls -l/-n show stored mode, type, size and timestamps; ls -s remains explicitly unsupported",
    "Pinned libc rejects pre-epoch or overflow touch dates before mutation",
    "tar supports regular files, directories and symbolic links; hard/special extraction and permission/owner restoration are unsupported",
    "tar -z/-a and child-process transformations are unsupported; use real tar/gzip/gunzip shell pipelines",
    "Archive output and extracted files use exclusive creation; conflicts fail nonzero while retaining existing bytes",
    "gzip/gunzip file overwrite -f and unzip -n/-o/-K/-t fail explicitly; gzip/gunzip stream -c/-t integrity operations use the real codec",
    "Archive extraction is not transactional; partial new entries can remain after an error; existing symlink parents and parent extraction paths are rejected"
  ],
  "commandStage": 4,
  "metadataAbi": {
    "namespace": "wasm_idle_fs_v1",

  bug-reports: "https://github.com/ocsigen/js_of_ocaml/issues"
  depends: [
    "dune" {>= "3.20"}
    "ocaml" {>= "4.13" & < "5.7"}
    "num" {with-test}
    "out-channel-redirect" {with-test}
    "ppxlib" {>= "0.33"}
    "ocaml-compiler-libs" {>= "v0.12.4"}

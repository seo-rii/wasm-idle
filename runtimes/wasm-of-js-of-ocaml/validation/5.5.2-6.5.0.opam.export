    [
      "cmdliner"
      "install"
      "tool-support"
      "--update-opam-install=%{_:name}%.install"
      "_build/install/default/bin/jsoo_minify" {os-family != "windows"}
      "_build/install/default/bin/jsoo_minify.exe:jsoo_minify"
        {os-family = "windows"}
      "_build/cmdliner-install"
    ]
  ]
  dev-repo: "git+https://github.com/ocsigen/js_of_ocaml.git"
  url {
    src:
      "https://github.com/ocsigen/js_of_ocaml/releases/download/6.5.0/js_of_ocaml-6.5.0.tbz"

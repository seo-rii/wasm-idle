package "js_of_ocaml" {
  opam-version: "2.0"
  version: "6.5.0"
  synopsis: "Compiler from OCaml bytecode to JavaScript"
  description:
    "Js_of_ocaml is a compiler from OCaml bytecode to JavaScript. It makes it possible to run pure OCaml programs in JavaScript environment like browsers and Node.js"
  maintainer: "Ocsigen team <dev@ocsigen.org>"
  authors: "Ocsigen team <dev@ocsigen.org>"
  license: [
    "GPL-2.0-or-later" "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
  ]
  homepage:
    "https://ocsigen.org/js_of_ocaml/latest/js_of_ocaml/overview.html"
  doc: "https://ocsigen.org/js_of_ocaml/latest/js_of_ocaml/overview.html"
  bug-reports: "https://github.com/ocsigen/js_of_ocaml/issues"
  depends: [
    "dune" {>= "3.20"}
    "ocaml" {>= "4.13"}
    "js_of_ocaml-compiler" {= version}
    "num" {with-test}
    "out-channel-redirect" {with-test}
    "ppxlib" {>= "0.33"}
    "re" {>= "1.9.0" & with-test}
    "odoc" {with-doc}
  ]
  build: [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@doc" {with-doc}
  ]
  dev-repo: "git+https://github.com/ocsigen/js_of_ocaml.git"
  url {
    src:
      "https://github.com/ocsigen/js_of_ocaml/releases/download/6.5.0/js_of_ocaml-6.5.0.tbz"
    checksum: [

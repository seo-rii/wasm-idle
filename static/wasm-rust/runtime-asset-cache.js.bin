const caches = new WeakMap();
/** A request-local fetch identity carries storage without mutating global fetch or worker policy. */
export function withRuntimeAssetPersistentCache(fetchImpl, cache) {
    if (!cache)
        return fetchImpl;
    const wrapped = (input, init) => fetchImpl(input, init);
    caches.set(wrapped, cache);
    return wrapped;
}
export function resolveRuntimeAssetPersistentCache(fetchImpl) {
    return caches.get(fetchImpl);
}
export async function waitForRuntimeAssetCache(operation, signal) {
    if (!signal)
        return operation;
    signal.throwIfAborted();
    return new Promise((resolve, reject) => {
        const abort = () => reject(signal.reason ?? new Error('Rust asset cache request aborted'));
        signal.addEventListener('abort', abort, { once: true });
        void operation
            .then(resolve, reject)
            .finally(() => signal.removeEventListener('abort', abort));
        if (signal.aborted)
            abort();
    });
}

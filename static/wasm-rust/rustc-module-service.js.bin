import { compileOwnedRustcModule } from './rustc-module.js';
import { DEFAULT_MAX_RUNTIME_ASSET_BYTES } from './runtime-asset.js';
// Cache only immutable compiler modules in the long-lived parent runtime realm.
// No guest memory, filesystem, source, instance or helper-thread state crosses runs.
const modules = new Map();
const MAX_MODULES = 2;
export function clearRustcModuleCache() { modules.clear(); }
export function createRustcModuleService(receipt) {
    if (!receipt || !globalThis.crypto?.subtle || typeof MessageChannel === 'undefined')
        return undefined;
    const expectedBytes = receipt.uncompressedBytes ?? receipt.bytes;
    const expectedHash = receipt.uncompressedSha256 ?? receipt.sha256;
    if (!Number.isSafeInteger(expectedBytes) || expectedBytes < 8 ||
        expectedBytes > DEFAULT_MAX_RUNTIME_ASSET_BYTES || !/^[a-f0-9]{64}$/.test(expectedHash)) {
        throw new Error('Invalid rustc module service receipt');
    }
    const channel = new MessageChannel();
    let closed = false;
    let received = false;
    let lookedUp = false;
    const finish = () => {
        closed = true;
        channel.port1.onmessage = null;
        channel.port1.onmessageerror = null;
        channel.port1.close();
    };
    const close = () => { finish(); channel.port2.close(); };
    channel.port1.onmessageerror = close;
    channel.port1.onmessage = (event) => {
        if (received || closed)
            return;
        const request = event.data;
        if (!lookedUp && request?.type === 'lookup' && Object.keys(request).length === 1) {
            // One lookup may precede the bytes: a retained module was compiled from bytes that
            // matched this receipt, so the worker can skip downloading and hashing rustc again.
            lookedUp = true;
            void (async () => {
                const retained = modules.get(`rustc-native-default-v1:${expectedHash}`);
                const module = retained ? await retained.catch(() => undefined) : undefined;
                if (closed)
                    return;
                if (module) {
                    received = true;
                    channel.port1.postMessage({ type: 'module', module });
                    finish();
                }
                else
                    channel.port1.postMessage({ type: 'miss' });
            })();
            return;
        }
        received = true;
        void (async () => {
            const message = event.data;
            if (!message || message.type !== 'compile' || !(message.bytes instanceof ArrayBuffer) ||
                message.bytes.byteLength !== expectedBytes)
                throw new Error('Invalid rustc module request');
            // Structured transfer gives this realm sole ownership. Recheck the pinned
            // logical receipt here; never accept a claimed hash or caller-supplied Module.
            const bytes = new Uint8Array(message.bytes);
            const hash = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)), byte => byte.toString(16).padStart(2, '0')).join('');
            if (hash !== expectedHash)
                throw new Error('rustc module service integrity mismatch');
            if (closed)
                return;
            const key = `rustc-native-default-v1:${hash}`;
            let compiled = modules.get(key);
            if (compiled) {
                modules.delete(key);
                modules.set(key, compiled);
            }
            else {
                compiled = compileOwnedRustcModule(bytes);
                modules.set(key, compiled);
                const operation = compiled;
                void operation.catch(() => { if (modules.get(key) === operation)
                    modules.delete(key); });
                while (modules.size > MAX_MODULES)
                    modules.delete(modules.keys().next().value);
            }
            const module = await compiled;
            if (!closed)
                channel.port1.postMessage({ type: 'module', module });
        })().catch(error => {
            try {
                if (!closed)
                    channel.port1.postMessage({ type: 'error', message: error instanceof Error ? error.message : String(error) });
            }
            catch { /* Peer closed during native compilation. */ }
        }).finally(finish);
    };
    return { port: channel.port2, close };
}
/**
 * Ask the module service for a retained rustc module before downloading the compiler. On a miss,
 * load the verified bytes and send them on the same port. A service that does not understand the
 * lookup (an older host) answers with an error; compile locally from the bytes in that case.
 */
export function obtainRustcThroughPort(port, loadBytes, timeoutMs = 120_000) {
    return new Promise((resolve, reject) => {
        let settled = false;
        let phase = 'lookup';
        let timer;
        const arm = () => {
            clearTimeout(timer);
            timer = setTimeout(() => finish(new Error('rustc module service timed out')), timeoutMs);
        };
        const release = () => {
            clearTimeout(timer);
            port.onmessage = null;
            port.onmessageerror = null;
            port.close();
        };
        const finish = (error, module) => {
            if (settled)
                return;
            settled = true;
            release();
            if (error)
                reject(error instanceof Error ? error : new Error(String(error)));
            else
                resolve({ module: module, reused: phase === 'lookup' });
        };
        port.onmessageerror = () => finish(new Error('rustc module response could not be cloned'));
        port.onmessage = (event) => {
            const data = event.data;
            if (data?.type === 'module' && data.module instanceof WebAssembly.Module) {
                finish(undefined, data.module);
                return;
            }
            if (phase === 'lookup' && (data?.type === 'miss' || data?.type === 'error')) {
                const local = data.type === 'error';
                phase = local ? 'local' : 'compile';
                // The download has its own deadline; this one covers only service round trips.
                clearTimeout(timer);
                if (local)
                    release();
                void loadBytes()
                    .then(async (bytes) => {
                    if (settled)
                        return;
                    if (local) {
                        const module = await compileOwnedRustcModule(bytes);
                        if (settled)
                            return;
                        settled = true;
                        resolve({ module, reused: false });
                        return;
                    }
                    arm();
                    const buffer = bytes.buffer instanceof ArrayBuffer && bytes.byteOffset === 0 && bytes.byteLength === bytes.buffer.byteLength
                        ? bytes.buffer : Uint8Array.from(bytes).buffer;
                    port.postMessage({ type: 'compile', bytes: buffer }, [buffer]);
                })
                    .catch((error) => {
                    if (!local)
                        return finish(error);
                    if (settled)
                        return;
                    settled = true;
                    reject(error instanceof Error ? error : new Error(String(error)));
                });
                return;
            }
            finish(new Error(typeof data?.message === 'string' ? data.message : 'Invalid rustc module response'));
        };
        arm();
        try {
            port.postMessage({ type: 'lookup' });
        }
        catch (error) {
            finish(error);
        }
    });
}
/** Called only after the one-shot compiler worker's verified, bounded asset fetch. */
export function compileRustcThroughPort(bytes, port, timeoutMs = 120_000) {
    return new Promise((resolve, reject) => {
        const finish = (error, module) => {
            clearTimeout(timer);
            port.onmessage = null;
            port.onmessageerror = null;
            port.close();
            if (error)
                reject(error);
            else
                resolve(module);
        };
        const timer = setTimeout(() => finish(new Error('rustc module service timed out')), timeoutMs);
        port.onmessageerror = () => finish(new Error('rustc module response could not be cloned'));
        port.onmessage = (event) => {
            if (event.data?.type === 'module' && event.data.module instanceof WebAssembly.Module)
                finish(undefined, event.data.module);
            else
                finish(new Error(typeof event.data?.message === 'string' ? event.data.message : 'Invalid rustc module response'));
        };
        try {
            const buffer = bytes.buffer instanceof ArrayBuffer && bytes.byteOffset === 0 && bytes.byteLength === bytes.buffer.byteLength
                ? bytes.buffer : Uint8Array.from(bytes).buffer;
            port.postMessage({ type: 'compile', bytes: buffer }, [buffer]);
        }
        catch (error) {
            finish(error instanceof Error ? error : new Error(String(error)));
        }
    });
}

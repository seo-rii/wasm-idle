# C3 assets are synced from the separately verified wasm-llvm producer.
/static/wasm-c3-lsp/
/static/wasm-c3/
# Common Lisp (ECL) assets are downloaded from the pinned wasm-llvm revision, never committed.
/static/wasm-commonlisp/
# LFortran producer artifacts are synced locally, never committed.
static/wasm-lfortran/
# Original PostgreSQL language server release files are prepared from pinned receipts.
/static/wasm-postgresql-lsp/
# Lean 4 assets are downloaded from the pinned wasm-llvm release, never committed.
/static/wasm-lean4/
# Original Bash LSP and parser binaries are built from the pinned producer dependencies.
/static/wasm-bash-lsp/

# Website container host graph and producer artifacts are prepared locally.
/static/container-app/
/static/container-app.preparing-*/

# Original Fennel LSP assets are produced from pinned source.
/static/wasm-fennel-lsp/
# Original Grain LSP and its verified runtime host are prepared locally.
/static/wasm-grain-lsp/
# Original SuperBOL OSS JavaScript and dialect data are mirrored from pinned assets.
/static/wasm-cobol-lsp/
/static/wasm-rescript-lsp/
/producers/rescript-language-server/node_modules/
# Original v-analyzer browser LSP assets are produced from pinned sources.
/static/wasm-v-lsp/
# Original Nim compiler/nimsuggest LSP assets are deployed externally.
/static/wasm-nim-lsp/
# Original javacs + TeaVM assets are built and verified locally.
/static/wasm-java-lsp/
/static/wasm-java-lsp.preparing-*/
/static/wasm-java-lsp.previous-*/

# Scala compiler graph is prepared from the immutable reviewed asset lock.
/static/wasm-scala/

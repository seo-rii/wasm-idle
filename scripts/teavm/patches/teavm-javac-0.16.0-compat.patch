+
+package org.teavm.javac;
+
+import java.util.ServiceLoader;
+import org.teavm.backend.wasm.TeaVMWasmGCHost;
+import org.teavm.classlib.impl.ServiceLoaderInformation;
+import org.teavm.classlib.impl.ServiceLoaderSupport;
+import org.teavm.classlib.impl.ServiceLoaderWasmGCSupport;
+import org.teavm.classlib.impl.reflection.ReflectionTransformer;
+import org.teavm.vm.TeaVM;
+
+/** Restores services skipped by JCLPlugin when the compiler itself runs in TeaVM. */
+final class BootstrapDependencySupport {
+    private BootstrapDependencySupport() {
+    }
+
+    static void install(TeaVM teavm) {
+        // In 0.16 ClassGenerator handles enum constants. WasmGCTarget installs the common
+        // reflection and annotation dependency listener; the old Wasm GC listener no longer exists.
+        teavm.add(new PluggableDependencySupport());
+        teavm.add(new ArrayCloneDependencySupport());
+        teavm.add(new ReflectionTransformer());
+        var serviceLoaderSupport = new ServiceLoaderSupport(teavm.getClassLoader(), teavm.getResourceProvider());
+        teavm.add(serviceLoaderSupport);
+        teavm.registerService(ServiceLoaderInformation.class, serviceLoaderSupport);
+        var wasmHost = teavm.getExtension(TeaVMWasmGCHost.class);
+        wasmHost.contributeToCodeGen((context, registry) -> {
+            registry.bodyIntrinsics().registerIntrinsic(ServiceLoader.class, new ServiceLoaderWasmGCSupport(
+                    serviceLoaderSupport, context.classInfoProvider(), context.functions(), context.functionTypes(),
+                    context.names(), context.typeMapper(), context.module()));
+        });
+    }
+}
diff --git a/compiler/src/main/java/org/teavm/javac/ClasslibSupplements.java b/compiler/src/main/java/org/teavm/javac/ClasslibSupplements.java
new file mode 100644
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/ClasslibSupplements.java
@@ -0,0 +1,285 @@
+/*
+ *  Copyright 2026 Alexey Andreev.
+ *
+ *  Licensed under the Apache License, Version 2.0 (the "License");
+ *  you may not use this file except in compliance with the License.
+ *  You may obtain a copy of the License at
+ *
+ *       http://www.apache.org/licenses/LICENSE-2.0
+ *
+ *  Unless required by applicable law or agreed to in writing, software
+ *  distributed under the License is distributed on an "AS IS" BASIS,
+ *  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ *  See the License for the specific language governing permissions and
+ *  limitations under the License.
+ */
+
+package org.teavm.javac;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+import org.objectweb.asm.AnnotationVisitor;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.FieldVisitor;
+import org.objectweb.asm.Handle;
+import org.objectweb.asm.Label;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.Type;
+
+/**
+ * Adds methods that the TeaVM class library lacks to its classes, in both the javac SDK and the runtime class
+ * library, so that both always declare the same API.
+ * <p>
+ * A supplement is a class of the {@code classlibSupplement} source set annotated with
+ * {@code @org.teavm.javac.supplement.Supplement(Target.class)}. To call members of the target, it extends the
+ * target, or for an interface, extends it. All its methods except constructors are copied to the target, with
+ * references to the supplement replaced by the target. The supplement may only add methods: it must not declare
+ * fields, static initializers, synthetic methods (lambdas) or methods the target already declares, and must not
+ * call {@code super} methods.
+ */
+public final class ClasslibSupplements {
+    private static final String SUPPLEMENT_DESC = "Lorg/teavm/javac/supplement/Supplement;";
+    private static final String SUPPLEMENT_ANNOTATION = "org/teavm/javac/supplement/Supplement";
+    private final Map<String, List<byte[]>> supplements = new LinkedHashMap<>();
+    private final Set<String> applied = new HashSet<>();
+
+    private ClasslibSupplements() {
+    }
+
+    public static ClasslibSupplements load(Path dir) throws IOException {
+        var result = new ClasslibSupplements();
+        var files = new TreeSet<Path>();
+        try (var stream = Files.walk(dir)) {
+            stream.filter(path -> Files.isRegularFile(path) && path.toString().endsWith(".class")).forEach(files::add);
+        }
+        for (var file : files) {
+            var bytes = Files.readAllBytes(file);
+            var reader = new ClassReader(bytes);
+            if (reader.getClassName().equals(SUPPLEMENT_ANNOTATION)) {
+                continue;
+            }
+            var target = findTarget(reader);
+            if (target == null) {
+                throw new IllegalStateException(reader.getClassName() + " is not annotated with @Supplement");
+            }
+            result.supplements.computeIfAbsent(target, key -> new ArrayList<>()).add(bytes);
+        }
+        return result;
+    }
+
+    private static String findTarget(ClassReader reader) {
+        var target = new String[1];
+        reader.accept(new ClassVisitor(Opcodes.ASM9) {
+            @Override
+            public AnnotationVisitor visitAnnotation(String desc, boolean visible) {
+                if (!desc.equals(SUPPLEMENT_DESC)) {
+                    return null;
+                }
+                return new AnnotationVisitor(Opcodes.ASM9) {
+                    @Override
+                    public void visit(String name, Object value) {
+                        if (name.equals("value")) {
+                            target[0] = ((Type) value).getInternalName();
+                        }
+                    }
+                };
+            }
+        }, ClassReader.SKIP_CODE | ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+        return target[0];
+    }
+
+    /**
+     * Returns the class with its supplements' methods added, or the class itself when it has no supplements.
+     */
+    public byte[] apply(byte[] bytes) {
+        var reader = new ClassReader(bytes);
+        var className = reader.getClassName();
+        var classSupplements = supplements.get(className);
+        if (classSupplements == null) {
+            return bytes;
+        }
+        if (!applied.add(className)) {
+            throw new IllegalStateException("Supplements of " + className + " are applied twice");
+        }
+        var writer = new ClassWriter(0);
+        var declared = new HashSet<String>();
+        reader.accept(new ClassVisitor(Opcodes.ASM9, writer) {
+            @Override
+            public MethodVisitor visitMethod(int access, String name, String desc, String signature,
+                    String[] exceptions) {
+                declared.add(name + desc);
+                return super.visitMethod(access, name, desc, signature, exceptions);
+            }
+
+            @Override
+            public void visitEnd() {
+                for (var supplement : classSupplements) {
+                    copyMethods(new ClassReader(supplement), className, declared, writer);
+                }
+                super.visitEnd();
+            }
+        }, 0);
+        return writer.toByteArray();
+    }
+
+    /**
+     * Fails unless every supplement was applied, i.e. the class library contained every target.
+     */
+    public void checkApplied() {
+        for (var target : supplements.keySet()) {
+            if (!applied.contains(target)) {
+                throw new IllegalStateException("Supplemented class " + target + " was not found");
+            }
+        }
+    }
+
+    private static void copyMethods(ClassReader supplement, String target, Set<String> declared, ClassWriter writer) {
+        var name = supplement.getClassName();
+        var supertypes = new ArrayList<String>(List.of(supplement.getInterfaces()));
+        if (!supplement.getSuperName().equals("java/lang/Object")) {
+            supertypes.add(supplement.getSuperName());
+        }
+        if (!supertypes.isEmpty() && !supertypes.equals(List.of(target))) {
+            throw new IllegalStateException(name + " must extend nothing but " + target);
+        }
+        var remapper = new Remapper(name, target);
+        supplement.accept(new ClassVisitor(Opcodes.ASM9) {
+            @Override
+            public FieldVisitor visitField(int access, String fieldName, String desc, String signature,
+                    Object value) {
+                throw new IllegalStateException(name + " must not declare fields");
+            }
+
+            @Override
+            public MethodVisitor visitMethod(int access, String methodName, String desc, String signature,
+                    String[] exceptions) {
+                if (methodName.equals("<init>")) {
+                    return null;
+                }
+                if (methodName.equals("<clinit>") || (access & (Opcodes.ACC_SYNTHETIC | Opcodes.ACC_BRIDGE)) != 0) {
+                    throw new IllegalStateException(name + "." + methodName + " can't be added to " + target);
+                }
+                desc = remapper.desc(desc);
+                if (!declared.add(methodName + desc)) {
+                    throw new IllegalStateException(target + " already declares " + methodName + desc);
+                }
+                var method = writer.visitMethod(access, methodName, desc, remapper.desc(signature), exceptions);
+                return new RemappingMethodVisitor(method, remapper, name + "." + methodName);
+            }
+        }, ClassReader.SKIP_DEBUG);
+    }
+
+    private static final class Remapper {
+        private final String from;
+        private final String to;
+
+        Remapper(String from, String to) {
+            this.from = from;
+            this.to = to;
+        }
+
+        String name(String name) {
+            return from.equals(name) ? to : name;
+        }
+
+        String desc(String desc) {
+            return desc == null ? null : desc.replace("L" + from + ";", "L" + to + ";");
+        }
+
+        Object value(Object value) {
+            if (value instanceof Type) {
+                var type = (Type) value;
+                return type.getSort() == Type.OBJECT ? Type.getObjectType(name(type.getInternalName()))
+                        : Type.getType(desc(type.getDescriptor()));
+            }
+            if (value instanceof Handle) {
+                var handle = (Handle) value;
+                return new Handle(handle.getTag(), name(handle.getOwner()), handle.getName(), desc(handle.getDesc()),
+                        handle.isInterface());
+            }
+            return value;
+        }
+
+        Object[] frame(Object[] values) {
+            if (values == null) {
+                return null;
+            }
+            var result = values.clone();
+            for (var i = 0; i < result.length; ++i) {
+                if (result[i] instanceof String) {
+                    result[i] = name((String) result[i]);
+                }
+            }
+            return result;
+        }
+    }
+
+    private static final class RemappingMethodVisitor extends MethodVisitor {
+        private final Remapper remapper;
+        private final String location;
+
+        RemappingMethodVisitor(MethodVisitor mv, Remapper remapper, String location) {
+            super(Opcodes.ASM9, mv);
+            this.remapper = remapper;
+            this.location = location;
+        }
+
+        @Override
+        public void visitFrame(int type, int numLocal, Object[] local, int numStack, Object[] stack) {
+            super.visitFrame(type, numLocal, remapper.frame(local), numStack, remapper.frame(stack));
+        }
+
+        @Override
+        public void visitTypeInsn(int opcode, String type) {
+            super.visitTypeInsn(opcode, remapper.name(type));
+        }
+
+        @Override
+        public void visitFieldInsn(int opcode, String owner, String name, String desc) {
+            super.visitFieldInsn(opcode, remapper.name(owner), name, remapper.desc(desc));
+        }
+
+        @Override
+        public void visitMethodInsn(int opcode, String owner, String name, String desc, boolean isInterface) {
+            if (opcode == Opcodes.INVOKESPECIAL && !name.equals("<init>")) {
+                throw new IllegalStateException(location + " must not call super or private methods");
+            }
+            super.visitMethodInsn(opcode, remapper.name(owner), name, remapper.desc(desc), isInterface);
+        }
+
+        @Override
+        public void visitInvokeDynamicInsn(String name, String desc, Handle bsm, Object... bsmArgs) {
+            var args = bsmArgs.clone();
+            for (var i = 0; i < args.length; ++i) {
+                args[i] = remapper.value(args[i]);
+            }
+            super.visitInvokeDynamicInsn(name, remapper.desc(desc), (Handle) remapper.value(bsm), args);
+        }
+
+        @Override
+        public void visitLdcInsn(Object value) {
+            super.visitLdcInsn(remapper.value(value));
+        }
+
+        @Override
+        public void visitMultiANewArrayInsn(String desc, int numDimensions) {
+            super.visitMultiANewArrayInsn(remapper.desc(desc), numDimensions);
+        }
+
+        @Override
+        public void visitTryCatchBlock(Label start, Label end, Label handler, String type) {
+            super.visitTryCatchBlock(start, end, handler, type == null ? null : remapper.name(type));
+        }
+    }
+}

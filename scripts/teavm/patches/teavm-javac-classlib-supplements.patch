+
+package org.teavm.javac.supplement;
+
+import org.teavm.classlib.java.lang.TInteger;
+
+@Supplement(TInteger.class)
+final class IntegerSupplement {
+    private IntegerSupplement() {
+    }
+
+    public static int sum(int a, int b) {
+        return a + b;
+    }
+
+    public static long toUnsignedLong(int x) {
+        return x & 0xFFFFFFFFL;
+    }
+
+    public static int parseUnsignedInt(String s) throws NumberFormatException {
+        return parseUnsignedInt(s, 10);
+    }
+
+    public static int parseUnsignedInt(String s, int radix) throws NumberFormatException {
+        if (s == null) {
+            throw new NumberFormatException("Cannot parse null string");
+        }
+        if (!s.isEmpty() && s.charAt(0) == '-') {
+            throw new NumberFormatException("Illegal leading minus sign on unsigned string " + s);
+        }
+        long value = Long.parseLong(s, radix);
+        if (value >>> 32 != 0) {
+            throw new NumberFormatException("String value " + s + " exceeds range of unsigned int");
+        }
+        return (int) value;
+    }
+}
diff --git a/compiler/src/classlibSupplement/java/org/teavm/javac/supplement/LongSupplement.java b/compiler/src/classlibSupplement/java/org/teavm/javac/supplement/LongSupplement.java

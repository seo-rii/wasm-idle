+ *  limitations under the License.
+ */
+
+package org.teavm.javac.supplement;
+
+import org.teavm.classlib.java.lang.TMath;
+
+@Supplement(TMath.class)
+final class MathSupplement {
+    private MathSupplement() {
+    }
+
+    public static long multiplyFull(int x, int y) {
+        return (long) x * (long) y;
+    }
+
+    // The high 64 bits of the signed 128-bit product, from products of 32-bit halves.
+    public static long multiplyHigh(long x, long y) {
+        long xHigh = x >> 32;
+        long xLow = x & 0xFFFFFFFFL;
+        long yHigh = y >> 32;
+        long yLow = y & 0xFFFFFFFFL;
+        long lowProduct = xLow * yLow;
+        long middle = xHigh * yLow + (lowProduct >>> 32);
+        long middleLow = xLow * yHigh + (middle & 0xFFFFFFFFL);
+        return xHigh * yHigh + (middle >> 32) + (middleLow >> 32);
+    }
+}

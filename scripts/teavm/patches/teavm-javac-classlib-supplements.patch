+
+package org.teavm.javac.supplement;
+
+import java.io.OutputStream;
+import org.teavm.classlib.java.io.TPrintStream;
+
+@Supplement(TPrintStream.class)
+abstract class PrintStreamSupplement extends TPrintStream {
+    PrintStreamSupplement() {
+        super((OutputStream) null);
+    }
+
+    // Without print(boolean) and print(float), javac picks print(Object) and print(double), which prints
+    // 0.1f as 0.10000000149011612.
+    public void print(boolean b) {
+        print(String.valueOf(b));
+    }
+
+    public void print(float f) {
+        print(String.valueOf(f));
+    }
+
+    // Without it, javac picks println(Object), which prints the array identity.
+    public void println(char[] s) {
+        print(s);
+        println();
+    }
+
+    public void writeBytes(byte[] buf) {
+        write(buf, 0, buf.length);
+    }
+}

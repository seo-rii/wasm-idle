+package org.teavm.javac;
+
+import org.teavm.classlib.java.lang.reflect.BaseAnnotationDependencyListener;
+import org.teavm.dependency.AbstractDependencyListener;
+import org.teavm.dependency.DependencyAgent;
+import org.teavm.dependency.FieldDependency;
+import org.teavm.model.ValueType;
+
+/**
+ * Tells dependency analysis that {@code String} elements of runtime annotations hold strings.
+ * <p>
+ * {@code WasmGCAnnotationDependencyListener} links the field of the generated annotation implementation that
+ * stores each element value, but propagates no type for {@code String} values. The element accessor then
+ * returns a value without types, and using it, e.g. in a string concatenation, dereferences a null pointer.
+ */
+class AnnotationStringDependencySupport extends AbstractDependencyListener {
+    private static final ValueType STRING = ValueType.object("java.lang.String");
+
+    @Override
+    public void fieldReached(DependencyAgent agent, FieldDependency field) {
+        var ref = field.getReference();
+        if (field.getField() == null || !ref.getFieldName().startsWith("$")
+                || !ref.getClassName().endsWith(BaseAnnotationDependencyListener.ANNOTATION_IMPLEMENTOR_SUFFIX)) {
+            return;
+        }
+        var type = field.getField().getType();
+        if (type.equals(STRING)) {
+            field.getValue().propagate(agent.getType(STRING));
+        } else if (type.equals(ValueType.arrayOf(STRING))) {
+            field.getValue().getArrayItem().propagate(agent.getType(STRING));
+        }
+    }
+}

diff --git a/compiler/build.gradle b/compiler/build.gradle
index 5598351..ef22a4a 100644
--- a/compiler/build.gradle
+++ b/compiler/build.gradle
@@ -35,12 +35,39 @@ dependencies {
 sourceSets {
     classlibEmu {
     }
+    teavmDeterminism {
+    }
+}
+
+dependencies {
+    // Non-transitive: only artifacts that the TeaVM build daemon already resolves.
+    teavmDeterminismCompileOnly(libs.teavm.core) {
+        transitive = false
+    }
+    teavmDeterminismCompileOnly("org.teavm:teavm-relocated-libs-hppc:${libs.versions.teavm.get()}") {
+        transitive = false
+    }
 }
 
 compileJava {
     options.compilerArgs.addAll("--limit-modules", "java.base")
 }
 
+// TeaVM 0.13.1 does not produce a byte-reproducible compiler.wasm: the order in which dependency
+// analysis reaches classes follows identity hash codes (TypeSet keeps DependencyNode domains in a
+// HashSet), and TagRegistry assigns the class tags used by Class.isInstance/isAssignableFrom range
+// checks in that order. src/teavmDeterminism holds copies of these two TeaVM 0.13.1 classes with
+// deterministic iteration; they go first on the classpath of the out-of-process TeaVM build daemon
+// and are not part of the compiled program.
+if (libs.versions.teavm.get() != "0.13.1") {
+    throw new GradleException("src/teavmDeterminism patches TeaVM 0.13.1 classes; "
+            + "re-check them against TeaVM ${libs.versions.teavm.get()}")
+}
+tasks.named("generateWasmGC") {
+    def teavmDaemonClasspath = new ArrayList<Object>(daemonClasspath.from)
+    daemonClasspath.setFrom(sourceSets.teavmDeterminism.output, teavmDaemonClasspath)
+}
+
 teavm {
     all {
         mainClass = "org.teavm.javac.CompilerLib"
diff --git a/compiler/src/teavmDeterminism/java/org/teavm/dependency/TypeSet.java b/compiler/src/teavmDeterminism/java/org/teavm/dependency/TypeSet.java

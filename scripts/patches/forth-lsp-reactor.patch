+//! Browser transport only. Parsing, indexing, diagnostics and every request handler remain upstream.
+use super::{ServerState, forth_lsp_capabilities};
+use lsp_server::{Connection, Message};
+use serde_json::{Value, json};
+use std::cell::{Cell, RefCell};
+
+struct Reactor {
+    server: Connection,
+    client: Connection,
+    state: Option<ServerState>,
+    shutdown: bool,
+}
+
+impl Reactor {
+    fn new() -> Self {
+        let (server, client) = Connection::memory();
+        Self {
+            server,
+            client,
+            state: None,
+            shutdown: false,
+        }
+    }
+
+    fn handle(&mut self, message: Value) -> Vec<Value> {
+        let id = message.get("id").cloned();
+        let method = message.get("method").and_then(Value::as_str).unwrap_or("");
+        let reply = |result: Value| json!({ "jsonrpc": "2.0", "id": id, "result": result });
+        if method == "initialize" {
+            let params = message
+                .get("params")
+                .cloned()
+                .unwrap_or(json!({ "capabilities": {} }));
+            return match ServerState::new(params) {
+                Ok(state) => {
+                    self.state = Some(state);
+                    vec![reply(json!({
+                        "capabilities": forth_lsp_capabilities(),
+                        "serverInfo": { "name": "forth-lsp", "version": env!("CARGO_PKG_VERSION") }
+                    }))]
+                }
+                Err(error) => vec![
+                    json!({ "jsonrpc": "2.0", "id": id, "error": { "code": -32603, "message": error.to_string() } }),
+                ],
+            };
+        }
+        if method == "shutdown" {
+            self.shutdown = true;
+            return vec![reply(Value::Null)];
+        }
+        if method == "exit" || method == "initialized" || method == "$/cancelRequest" {
+            return vec![];
+        }
+        if self.shutdown || self.state.is_none() {
+            return if id.is_some() {
+                vec![
+                    json!({ "jsonrpc": "2.0", "id": id, "error": { "code": -32002, "message": "server is not initialized" } }),
+                ]
+            } else {
+                vec![]
+            };
+        }
+        let state = self.state.as_mut().unwrap();
+        // The browser host releases closed buffers and their indices; no language analysis is added.
+        if method == "textDocument/didClose" {
+            if let Some(uri) = message
+                .pointer("/params/textDocument/uri")
+                .and_then(Value::as_str)
+            {
+                state.files.remove(uri);
+                state.def_index.remove_file(uri);
+                return vec![
+                    json!({ "jsonrpc": "2.0", "method": "textDocument/publishDiagnostics", "params": { "uri": uri, "diagnostics": [] } }),
+                ];
+            }
+            return vec![];
+        }
+        let handled = serde_json::from_value::<Message>(message.clone())
+            .map_err(|error| error.to_string())
+            .and_then(|message| {
+                state
+                    .handle_message(message, &self.server)
+                    .map_err(|error| error.to_string())
+            });
+        if let Err(error) = handled {
+            return if id.is_some() {
+                vec![
+                    json!({ "jsonrpc": "2.0", "id": id, "error": { "code": -32603, "message": error } }),
+                ]
+            } else {
+                vec![]
+            };
+        }
+        let mut messages = Vec::new();
+        while let Ok(message) = self.client.receiver.try_recv() {
+            let mut value = serde_json::to_value(message).unwrap();
+            value
+                .as_object_mut()
+                .unwrap()
+                .insert("jsonrpc".into(), json!("2.0"));
+            messages.push(value);
+        }
+        if id.is_some()
+            && !messages
+                .iter()
+                .any(|message| message.get("id") == id.as_ref())
+        {
+            messages.push(json!({ "jsonrpc": "2.0", "id": id, "error": { "code": -32601, "message": "method not found" } }));
+        }
+        messages
+    }
+}
+
+thread_local! {
+    static REACTOR: RefCell<Reactor> = RefCell::new(Reactor::new());
+    static RESPONSE_LEN: Cell<usize> = const { Cell::new(0) };
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn lsp_alloc(len: usize) -> *mut u8 {
+    Box::into_raw(vec![0; len].into_boxed_slice()) as *mut u8
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lsp_dealloc(ptr: *mut u8, len: usize) {
+    if !ptr.is_null() {
+        unsafe {
+            drop(Box::from_raw(std::ptr::slice_from_raw_parts_mut(ptr, len)));
+        }
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lsp_handle(ptr: *const u8, len: usize) -> *mut u8 {
+    let bytes = unsafe { std::slice::from_raw_parts(ptr, len) };
+    let messages = match serde_json::from_slice::<Value>(bytes) {
+        Ok(message) => REACTOR.with(|reactor| reactor.borrow_mut().handle(message)),
+        Err(_) => vec![],
+    };
+    let output = serde_json::to_vec(&messages).unwrap().into_boxed_slice();
+    RESPONSE_LEN.with(|len| len.set(output.len()));
+    Box::into_raw(output) as *mut u8
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn lsp_response_len() -> usize {
+    RESPONSE_LEN.with(Cell::get)
+}

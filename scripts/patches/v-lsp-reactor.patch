@@ -0,0 +1,49 @@
+module main
+import os
+import io
+import analyzer
+import server
+import jsonrpc
+import loglib as _
+__global (
+ memory_stream = unsafe { &MemoryStream(nil) }
+ reactor = unsafe { &jsonrpc.Server(nil) }
+)
+@[heap]
+struct MemoryStream { mut:
+ request []u8
+ response []u8
+}
+fn (mut m MemoryStream) read(mut b []u8) !int {
+ if m.request.len == 0 { return IError(io.Eof{}) }
+ n := m.request.len
+ b << m.request
+ m.request = []
+ return n
+}
+fn (mut m MemoryStream) write(b []u8) !int {
+ m.response << b
+ return b.len
+}
+fn main() {}
+@[export: 'lsp_init']
+fn lsp_init() {
+ os.setenv('VROOT','/v',true)
+ os.setenv('VMODULES','/v/modules',true)
+ os.mkdir_all('/v/modules') or {}
+ os.mkdir_all('/workspace') or {}
+ memory_stream = &MemoryStream{}
+ mut ls := server.LanguageServer.new(analyzer.IndexingManager.new())
+ reactor = &jsonrpc.Server{stream: memory_stream, handler: ls}
+}
+@[export: 'lsp_handle']
+fn lsp_handle(p &u8, n int) {
+ memory_stream.response.clear()
+ text := unsafe { p.vstring_with_len(n) }
+ memory_stream.request = ('Content-Length: ${n}\r\n\r\n'+text).bytes()
+ reactor.respond() or { eprintln(err) }
+}
+@[export: 'lsp_response_ptr']
+fn lsp_response_ptr() &u8 { return memory_stream.response.data }
+@[export: 'lsp_response_len']
+fn lsp_response_len() int { return memory_stream.response.len }

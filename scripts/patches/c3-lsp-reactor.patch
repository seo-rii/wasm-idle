+module lsp;
+import std::core::mem;
+import std::core::dstring;
+
+LspServer wasm_server;
+DString wasm_output;
+bool wasm_started;
+
+fn void lsp_init() @cname("lsp_init") @wasm
+{
+ if (wasm_started) return;
+ wasm_started = true;
+ wasm_output = dstring::new(mem);
+ wasm_server.init("/c3/lib/std", "", 0);
+}
+fn char* lsp_alloc(sz len) @cname("lsp_alloc") @wasm
+{
+ char[] bytes = mem::new_array(char, len);
+ return bytes.ptr;
+}
+fn void lsp_free(char* ptr) @cname("lsp_free") @wasm
+{
+ mem::free(ptr);
+}
+fn void lsp_handle(char* ptr, sz len) @cname("lsp_handle") @wasm
+{
+ lsp_init();
+ wasm_output.clear();
+ @pool()
+ {
+  wasm_server.handle_message((String)ptr[:len]);
+ };
+}
+fn char* lsp_response_ptr() @cname("lsp_response_ptr") @wasm
+{
+ return (char*)wasm_output.str_view().ptr;
+}
+fn sz lsp_response_len() @cname("lsp_response_len") @wasm
+{
+ return wasm_output.len();
+}
+fn void send_message(String json) @feat(EMSCRIPTEN)
+{
+ wasm_output.append(json);
+ wasm_output.append("\n");
+}
+fn String detect_stdlib_path(String compiler_path) @feat(EMSCRIPTEN) => "";
+// Browser builds preserve the upstream lexer diagnostics; no subprocess is available.
+fn void LspServer.publish_compiler_diagnostics(&self, String uri) @feat(EMSCRIPTEN) {}

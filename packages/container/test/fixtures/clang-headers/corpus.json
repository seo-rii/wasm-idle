    "resource.c": {
      "text": "#include <stddef.h>\n#include <stdint.h>\n#include <stdatomic.h>\nstruct sample { char label; uint32_t value; };\n_Static_assert(offsetof(struct sample, value) >= 1, \"stddef layout\");\nint header_resource_probe(uint32_t input) {\n  atomic_uint value = ATOMIC_VAR_INIT(input);\n  atomic_store_explicit(&value, input + 1, memory_order_relaxed);\n  return (int)atomic_load_explicit(&value, memory_order_relaxed);\n}\n",
